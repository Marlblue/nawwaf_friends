# Salin jadi .env.local (lokal) atau isi di environment server produksi.

# Google Apps Script Web App URL (berakhiran /exec) untuk form kolaborasi KOL di
# /hubungi/kolaborasi. Tanpa prefix NEXT_PUBLIC_ karena hanya dipakai server-side
# di app/api/kolaborasi/route.ts.
# (langkah deploy-nya ada di scripts/apps-script/collaboration-form.gs)
COLLAB_SCRIPT_URL=

# Google Apps Script Web App URL untuk form kolaborasi komunitas di
# /hubungi/komunitas. Sheet-nya terpisah dari form KOL.
# (langkah deploy-nya ada di scripts/apps-script/community-form.gs)
COMMUNITY_SCRIPT_URL=

# Teks acak panjang, sama persis dengan Script Property SHARED_SECRET di kedua
# project Apps Script. Kosong atau beda = semua submit ditolak "unauthorized".
FORMS_SHARED_SECRET=
